# https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional overrides
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
EMBED_MODEL=BAAI/bge-small-en-v1.5
USE_HYDE=true

# Qdrant — started by `docker compose up -d`, see docker-compose.yml
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=travel_chunks
# Intentionally empty. The compose file starts Qdrant with no api-key, so blank
# is correct for local Docker — this is not a missing setting. Only fill it in
# if you point QDRANT_URL at Qdrant Cloud or a secured server, and then put the
# real value in .env, never here.
QDRANT_API_KEY=
