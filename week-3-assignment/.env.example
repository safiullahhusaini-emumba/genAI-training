# Copy this file to .env and fill in real values. .env is gitignored and
# dockerignored -- it never enters a git commit or an image layer.

GROQ_API_KEY=

# https://app.tavily.com/ -> sign up -> API key. 1,000 credits/month, no card.
TAVILY_API_KEY=

# https://dash.cloudflare.com/ -> sign up (free, no card) -> Account ID from
# the dashboard's right-hand sidebar.
CLOUDFLARE_ACCOUNT_ID=

# Same dashboard -> My Profile -> API Tokens -> Create Token -> use the
# "Workers AI" template (read is enough). 10,000 free neurons/day, no card.
CLOUDFLARE_API_TOKEN=
